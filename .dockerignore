# Чем меньше контекста уходит в docker build, тем быстрее сборка — и тем меньше
# шансов случайно запечь в образ секреты или чужую базу.
.git
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]

# Локальные база и загруженные файлы — на проде свои (Postgres + том media).
db.sqlite3
media/
staticfiles/

# Секреты
.env
.env.prod

# Фронтенд собирается внутри образа из исходников (стадия `frontend` в
# Dockerfile копирует frontend/ целиком — поэтому его картинки и иконки
# исключению ниже не подлежат).
node_modules/
**/node_modules/
frontend/dist/

# Не нужно ни в одной стадии образа (Dockerfile копирует только backend-код,
# frontend/ и deploy/entrypoint.sh). Скриншоты ревизии интерфейса весят ~50 МБ,
# а в git они остаются — здесь они только не попадают в контекст сборки.
ui-review/
docs/
.github/
*.tsv
**/*.png
!frontend/**/*.png
db.sqlite3-journal
.pytest_cache/
.ruff_cache/

# Прочее
.DS_Store
.idea/
.vscode/
.claude/
*.md
