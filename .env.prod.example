# Прод-окружение. На сервере скопировать в .env.prod и заполнить.
# ВАЖНО: .env.prod в git не коммитится (см. .gitignore).
#
#     cp .env.prod.example .env.prod && nano .env.prod

# --- Основное ---
DEBUG=False
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=ЗАМЕНИТЬ-НА-СЛУЧАЙНУЮ-СТРОКУ
ALLOWED_HOSTS=chpucenter.com,www.chpucenter.com
SITE_BASE_URL=https://chpucenter.com

# Фронтенд ходит на тот же домен (nginx проксирует /api), поэтому CORS по сути
# не нужен — оставляем сам домен на случай запросов с www.
CORS_ALLOWED_ORIGINS=https://chpucenter.com,https://www.chpucenter.com
# Нужно для формы входа в /admin/ — Django проверяет источник POST-запроса.
CSRF_TRUSTED_ORIGINS=https://chpucenter.com,https://www.chpucenter.com

# --- База данных ---
# Пароль придумать свой. Этот же файл целиком передаётся в контейнер postgres,
# поэтому POSTGRES_* должны лежать именно здесь (docker compose не умеет
# подставлять переменные из файла с именем, отличным от «.env»).
POSTGRES_DB=chpu
POSTGRES_USER=chpu
POSTGRES_PASSWORD=ЗАМЕНИТЬ-НА-ПАРОЛЬ
# Хост `db` — имя сервиса из docker-compose.prod.yml, менять не нужно.
DATABASE_URL=postgres://chpu:ЗАМЕНИТЬ-НА-ПАРОЛЬ@db:5432/chpu

# --- Пароль на финансовые экраны (поверх входа админа) ---
FINANCE_PASSWORD=ЗАМЕНИТЬ-НА-СВОЙ-ПАРОЛЬ

# --- Telegram (когда будут токены от @BotFather) ---
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_IDS=
TELEGRAM_CUSTOMER_BOT_TOKEN=

# --- Платёжный шлюз ---
# Пока ключей FreedomPay нет — оставляем mock. ВНИМАНИЕ: при mock включается
# служебный эндпоинт «оплата прошла» без авторизации. Для боевых денег
# ставить freedompay и заполнить ключи.
PAYMENT_GATEWAY=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- HTTPS ---
# Редирект делает nginx, поэтому здесь False (иначе возможна петля редиректов).
SECURE_SSL_REDIRECT=False
# HSTS: включать (например 31536000 = год) только когда убедились, что сайт
# стабильно открывается по https. Браузер запомнит это надолго.
SECURE_HSTS_SECONDS=0
