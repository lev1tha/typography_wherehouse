# Тестовый стенд test.chpucenter.com. На сервере, в /opt/chpucenter-staging:
#
#     cp .env.staging.example .env.staging && nano .env.staging
#
# ВАЖНО: .env.staging в git не коммитится (см. .gitignore).
# НЕ копировать сюда .env.prod целиком: в нём токены Telegram — стенд с копией
# боевой базы начнёт слать уведомления в рабочий чат и отвечать клиентам.

# --- Основное ---
DEBUG=False
# Свой, НЕ как на проде: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=ЗАМЕНИТЬ-НА-СЛУЧАЙНУЮ-СТРОКУ
ALLOWED_HOSTS=test.chpucenter.com
SITE_BASE_URL=https://test.chpucenter.com
CORS_ALLOWED_ORIGINS=https://test.chpucenter.com
CSRF_TRUSTED_ORIGINS=https://test.chpucenter.com

# --- База данных стенда (своя, в своём контейнере) ---
POSTGRES_DB=chpu_test
POSTGRES_USER=chpu_test
POSTGRES_PASSWORD=ЗАМЕНИТЬ-НА-ПАРОЛЬ
DATABASE_URL=postgres://chpu_test:ЗАМЕНИТЬ-НА-ПАРОЛЬ@db:5432/chpu_test

# nginx стенда (deploy/nginx/test.chpucenter.com) перезаписывает X-Forwarded-For
# так же, как прод-конфиг, поэтому защиту входа можно включить сразу.
TRUSTED_PROXY_COUNT=1

# --- Пароль на финансовые экраны ---
# Можно взять тот же, что на проде, чтобы владелец не путался, — стенд закрыт
# паролем nginx.
FINANCE_PASSWORD=ЗАМЕНИТЬ-НА-СВОЙ-ПАРОЛЬ

# --- Telegram: на стенде ВСЕГДА пусто ---
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_IDS=
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Оплата: только заглушка ---
PAYMENT_GATEWAY=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# HTTPS снимает Cloudflare и nginx; как на проде.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
