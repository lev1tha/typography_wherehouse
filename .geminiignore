# Что Gemini CLI не читает в этом репозитории. То, что уже в .gitignore, он
# пропускает сам; здесь — файлы из git, которые в контексте только мешают, и
# секреты на всякий случай ещё раз.

# Секреты и базы
.env
.env.prod
*.sqlite3
*.sql
*.sql.gz

# Скриншоты ревизии интерфейса (~340 картинок; отчёт ui-review/REPORT.md читать можно)
ui-review/*.png

# Рабочие копии других сессий и настройки IDE
.claude/worktrees/
.idea/
.venv/

# Сборка и зависимости фронтенда
frontend/node_modules/
frontend/dist/
frontend/package-lock.json

# Загруженные фото и черновики массового ввода
media/
*.tsv
